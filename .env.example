# Frontend API URL (Production: https://enterprise-succession-planning-dashboard.onrender.com/api, Local dev: http://localhost:5000/api)
VITE_API_URL=https://enterprise-succession-planning-dashboard.onrender.com/api

# Database Configuration (Supabase PostgreSQL connection string)
# Configure your real connection string in Render Environment Variables (Supabase -> Connect -> Session Pooler).
# Example format: postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:5432/postgres
# Do NOT commit real credentials or password to Git repository.
DATABASE_URL=<REAL_SUPABASE_POSTGRESQL_CONNECTION_STRING>

# Application Security Keys
SECRET_KEY=your_production_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# AI / ML Configuration
AI_MODEL_PATH=ml/model.joblib

# SQLite Fallback Option (true/false)
USE_SQLITE=false

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,https://enterprise-succession-planning-dash.vercel.app

# Supabase Auth Configuration (Production Project: https://livemvqdyupoipuajury.supabase.co)
SUPABASE_URL=https://livemvqdyupoipuajury.supabase.co
