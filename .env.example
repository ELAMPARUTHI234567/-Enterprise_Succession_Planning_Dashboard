# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# Database Configuration (Supabase PostgreSQL connection string)
# IMPORTANT: PROJECT_REF, PASSWORD, and POOLER_HOST are placeholders. 
# Do NOT commit real credentials. Configure actual connection string in Render Environment Variables.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Application Security Keys
SECRET_KEY=your_production_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# AI / ML Configuration
AI_MODEL_PATH=ml/model.joblib

# SQLite Fallback Option (true/false)
USE_SQLITE=false

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,https://your-app-name.vercel.app
