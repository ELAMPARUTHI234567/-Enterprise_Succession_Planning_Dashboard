# Supabase PostgreSQL Database Configuration
# Configure your real connection string in Render Environment Variables (Supabase -> Connect -> Session Pooler).
# Example format: postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:5432/postgres
# Do NOT commit real credentials or password to Git repository.
DATABASE_URL=<REAL_SUPABASE_POSTGRESQL_CONNECTION_STRING>

# App Configuration
SECRET_KEY=your_production_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
FLASK_ENV=production
PORT=5000
USE_SQLITE=false
CORS_ORIGINS=http://localhost:5173,https://your-app-name.vercel.app
AI_MODEL_PATH=ml/model.joblib
